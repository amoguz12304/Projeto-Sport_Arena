  "components": {
    "schemas": {
      "Carrinho": {
        "required": [
          "usuarioId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "usuarioId": {
            "type": "string",
            "format": "uuid"
          },
          "itens": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CarrinhoItem"
            }
          }
        }
      },
      "CarrinhoItem": {
        "required": [
          "carrinhoId",
          "produtoId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "carrinhoId": {
            "type": "string",
            "format": "uuid"
          },
          "produtoId": {
            "type": "string",
            "format": "uuid"
          },
          "quantidade": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "produto": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Produto"
              }
            ]
          }
        }
      },
      "Categoria": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "produtos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Produto"
            }
          }
        }
      },
      "Produto": {
        "required": [
          "nome",
          "categoriaId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "descricao": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string"
          },
          "preco": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "categoriaId": {
            "type": "string",
            "format": "uuid"
          },
          "modelo": {
            "type": "string"
          },
          "estoque": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "imagem": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Usuario": {
        "required": [
          "nome",
          "idade",
          "email",
          "cpf",
          "senha"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "idade": {
            "maximum": 100,
            "minimum": 1,
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "email": {
            "type": "string"
          },
          "cpf": {
            "maxLength": 11,
            "minLength": 11,
            "type": "string"
          },
          "senha": {
            "maxLength": 100,
            "minLength": 8,
            "type": "string"
          },
          "foto": {
            "type": [
              "null",
              "string"
